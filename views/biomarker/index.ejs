<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Biomarkers</title>
    <link rel="stylesheet" href="/css/bio.css">
  </head>

  <body>
    <div class="data-holder">

      <!-- Header -->
      <div class="dash-header">
        <h1>
          <span>// Health Monitor</span>
          Biomarkers
        </h1>
        <div class="dash-date" id="dashDate">
          <strong>--</strong>
          Week View
        </div>
      </div>

      <!-- Weekly Summary Row -->
      <div class="weekly-row">
        <div class="weekly-card">
          <div class="label">Weekly Calories</div>
          <div class="value" id="wkCals"><%= weekly.calories_sum ?? '--' %> kcal</div>
        </div>
        <div class="weekly-card">
          <div class="label">Avg Sleep</div>
          <div class="value green" id="wkSleep"><%= weekly.sleep_hours_avg ? parseFloat(weekly.sleep_hours_avg).toFixed(1) : '--' %> hrs</div>
        </div>
        <div class="weekly-card">
          <div class="label">Days Logged</div>
          <div class="value purple" id="wkDays"><%= weekly.days_logged ?? '--' %> / 7</div>
        </div>
      </div>

      <!-- Stat Cards -->
      <div class="bio-stats">
        <div class="stat-card" id="calories">
          <h3>Calories</h3>
          <p class="stat-value"><%= today.calories ?? '--' %></p>
          <div class="stat-unit">kcal today</div>
        </div>
        <div class="stat-card" id="steps">
          <h3>Steps</h3>
          <p class="stat-value"><%= today.step_count ?? '--' %></p>
          <div class="stat-unit">steps today</div>
        </div>
        <div class="stat-card" id="sleep">
          <h3>Sleep</h3>
          <p class="stat-value"><%= today.sleep_hours ?? '--' %></p>
          <div class="stat-unit">hours last night</div>
        </div>
        <div class="stat-card" id="water">
          <h3>Water</h3>
          <p class="stat-value"><%= today.water_intake ?? '--' %></p>
          <div class="stat-unit">litres today</div>
        </div>
        <div class="stat-card" id="weight">
          <h3>Weight</h3>
          <p class="stat-value"><%= today.weight ?? '--' %></p>
          <div class="stat-unit">kg</div>
        </div>
      </div>

      <!-- Charts -->
      <div class="charts-grid">

        <div class="chart-wrapper">
          <div class="chart-header">
            <h2>Calorie Count — This Week</h2>
            <span class="chart-badge live">● Live</span>
          </div>
          <canvas class="bioCanvas" id="CalorieChart"></canvas>
        </div>

        <div class="chart-wrapper">
          <div class="chart-header">
            <h2>Sleep Duration</h2>
            <span class="chart-badge">hrs / night</span>
          </div>
          <canvas class="bioCanvas" id="sleepChart"></canvas>
        </div>

        <div class="chart-wrapper">
          <div class="chart-header">
            <h2>Weekly Completion</h2>
            <span class="chart-badge">7-day view</span>
          </div>
          <canvas class="bioCanvas" id="pieChart"></canvas>
        </div>

      </div>
    </div>

    <!-- Chart.js -->
    <script type="module">
      import { generateNavBar, generateBackground } from '/javascript/components/controller.js'
      generateNavBar();
      generateBackground();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
      const calsData   = <%- JSON.stringify(cals) %>;
      const sleepData  = <%- JSON.stringify(sleep) %>;
      const weeklyData = <%- JSON.stringify(weekly) %>;

      const now = new Date();
      document.getElementById('dashDate').innerHTML =
        `<strong>${now.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short' })}</strong>Week View`;
    </script>
    <script src='/javascript/bio.js'></script>
  </body>
</html>
