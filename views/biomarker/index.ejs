<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Biomarkers</title>
    <link rel="stylesheet" href="/css/bio.css">
  </head>

  <body>
    <div class="data-holder">

      <div class="dash-header">
        <h1>
          <span>// Health Monitor</span>
          Biomarkers
        </h1>
        <div class="dash-date" id="dashDate">
          <strong>--</strong>
          Week View
        </div>
      </div>
      <% if (!isFriend) { %>
        <div class="log-section card">
          <h2>Log Daily Data</h2>
            <form action="/biomarker/log" method="POST" class="log-form">
            <div class="form-row">
              <label>Date:</label>
              <input type="date" name="log_date" required>
            </div>
            <div class="form-row">
              <label>Calories (kcal):</label>
              <input type="number" name="calories" placeholder="e.g. 2000">
            </div>
            <div class="form-row">
              <label>Steps:</label>
              <input type="number" name="step_count" placeholder="e.g. 10000">
            </div>
            <div class="form-row">
              <label>Sleep (hrs):</label>
              <input type="number" step="0.1" name="sleep_hours" placeholder="e.g. 7.5">
            </div>
            <div class="form-row">
              <label>Water (litres):</label>
              <input type="number" step="0.1" name="water_intake" placeholder="e.g. 2.5">
            </div>
            <div class="form-row">
              <label>Weight (kg):</label>
              <input type="number" step="0.1" name="weight" placeholder="e.g. 70.5">
            </div>
            <button type="submit" class="btn-submit">Save Log</button>
          </form>
        </div>
      <% } %>

      <div class="weekly-row">
        <div class="weekly-card">
          <div class="label">Weekly Calories</div>
          <div class="value" id="wkCals"><%= weekly.calories_sum ?? '--' %> kcal</div>
        </div>
        <div class="weekly-card">
          <div class="label">Avg Sleep</div>
          <div class="value green" id="wkSleep"><%= weekly.sleep_hours_avg ? parseFloat(weekly.sleep_hours_avg).toFixed(1) : '--' %> hrs</div>
        </div>
        <div class="weekly-card">
          <div class="label">Days Logged This Week</div>
          <div class="value purple" id="wkDays"><%= weekly.days_logged ?? '--' %> / 7</div>
        </div>
      </div>

      <div class="bio-stats">
        <div class="stat-card" id="calories">
          <h3>Calories</h3>
          <p class="stat-value"><%= today.calories ?? '--' %></p>
          <div class="stat-unit">kcal today</div>
        </div>
        <div class="stat-card" id="steps">
          <h3>Steps</h3>
          <p class="stat-value"><%= today.step_count ?? '--' %></p>
          <div class="stat-unit">steps today</div>
        </div>
        <div class="stat-card" id="sleep">
          <h3>Sleep</h3>
          <p class="stat-value"><%= today.sleep_hours ?? '--' %></p>
          <div class="stat-unit">hours last night</div>
        </div>
        <div class="stat-card" id="water">
          <h3>Water</h3>
          <p class="stat-value"><%= today.water_intake ?? '--' %></p>
          <div class="stat-unit">litres today</div>
        </div>
        <div class="stat-card" id="weight">
          <h3>Weight</h3>
          <p class="stat-value"><%= today.weight ?? '--' %></p>
          <div class="stat-unit">kg</div>
        </div>
      </div>

      <div class="charts-grid">

        <div class="chart-wrapper">
          <div class="chart-header">
            <h2>Calorie Count — This Week</h2>
            <span class="chart-badge live">● Live</span>
          </div>
          <canvas class="bioCanvas" id="CalorieChart"></canvas>
        </div>

        <div class="chart-wrapper">
          <div class="chart-header">
            <h2>Sleep Duration</h2>
            <span class="chart-badge">hrs / night</span>
          </div>
          <canvas class="bioCanvas" id="sleepChart"></canvas>
        </div>

        <div class="chart-wrapper">
          <div class="chart-header">
            <h2>Weekly Completion</h2>
            <span class="chart-badge">7-day view</span>
          </div>
          <canvas class="bioCanvas" id="pieChart"></canvas>
        </div>

      </div>
    </div>

    <script type="module">
      import { generateNavBar, generateBackground } from '/javascript/components/controller.js'
      generateNavBar();
      generateBackground();
    </script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    
    <script>
      // Load data from backend
      const calsData   = <%- JSON.stringify(cals) %>;
      const sleepData  = <%- JSON.stringify(sleep) %>;
      const weeklyData = <%- JSON.stringify(weekly) %>;

      // Generate the last 7 dates for the charts (e.g. 17/03/26)
      function getLast7Days() {
        const dates = [];
        for (let i = 6; i >= 0; i--) {
          const d = new Date();
          d.setDate(d.getDate() - i);
          const day = String(d.getDate()).padStart(2, '0');
          const month = String(d.getMonth() + 1).padStart(2, '0');
          const year = String(d.getFullYear()).slice(-2);
          dates.push(`${day}/${month}/${year}`);
        }
        return dates;
      }
      
      // Store the generated dates globally so bio.js can use them
      const dynamicDateLabels = getLast7Days();

      // Set the dashboard header date
      const now = new Date();
      document.getElementById('dashDate').innerHTML =
        `<strong>${now.toLocaleDateString('en-GB', { weekday: 'long', day: 'numeric', month: 'short' })}</strong>Week View`;
    </script>
    
    <script>
      // Auto-fill today's date in the log form
      document.addEventListener('DOMContentLoaded', () => {
        const dateInput = document.querySelector('input[name="log_date"]');
        if (dateInput) {
          // 'en-CA' safely formats the local date to YYYY-MM-DD which the input requires
          dateInput.value = new Date().toLocaleDateString('en-CA');
        }
      });
    </script>
    
    <script src='/javascript/bio.js'></script>
  </body>
</html>
