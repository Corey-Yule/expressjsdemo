<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, intial-scale=1" />
    <link rel="stylesheet" href="/css/home.css">
    <title>Home</title>
</head>
<body>
    <div class="profile-card">
    
   <div class="card-header">
        <div class="avatar-container">
            <img src="/Images/1st-place-avatar.png" alt="Player sprite" class="character-sprite">
        </div>
        <div class="user-info">
            <h1 class="player-name"><%= missionStats.username %></h1>
            <div class="level-badge">
                <span class="level-text">Lv.</span>
                <span class="level-number" id="level-number"><%= missionStats.level %></span>
            </div>
        </div>
    </div>

    <div class="progress-section">
        <div class="level-progress-text">
            <span id="level-progress-text"><%= missionStats.progressText %></span>
        </div>
        <div class="level-bar">
            <div class="level-bar-fill" id="level-bar-fill" style="width: <%= missionStats.progressPercent %>%;"></div>
        </div>
    </div>

    <div class="stats-grid">
        <div class="stat-item">
            <img src="/Images/Burger.png" alt="Calories" class="stat-icon">
            <div class="stat-details">
                <span class="stat-value" id="stat-calories"><%= today.calories ?? '--' %></span>
                <span class="stat-label">Kcal</span>
            </div>
        </div>

        <div class="stat-item">
            <img src="/Images/Bed.png" alt="Sleep" class="stat-icon">
            <div class="stat-details">
                <span class="stat-value" id="stat-sleep"><%= today.sleep_hours ?? '--' %></span>
                <span class="stat-label">Sleep</span>
            </div>
        </div>

        <div class="stat-item">
            <img src="/Images/Kettle.png" alt="Weight" class="stat-icon">
            <div class="stat-details">
                <span class="stat-value" id="stat-weight"><%= today.weight ?? '--' %></span>
                <span class="stat-label">Kg</span>
            </div>
        </div>

        <div class="stat-item">
            <img src="/Images/Tread.png" alt="Steps" class="stat-icon">
            <div class="stat-details">
                <span class="stat-value" id="stat-steps"><%= today.step_count ?? '--' %></span>
                <span class="stat-label">Steps</span>
            </div>
        </div>

        <div class="stat-item">
            <img src="/Images/Water.png" alt="Water" class="stat-icon">
            <div class="stat-details">
                <span class="stat-value" id="stat-water"><%= today.water_intake ?? '--' %></span>
                <span class="stat-label">Water(L)</span>
            </div>
        </div>
    </div>
</div>

    <script src="/javascript/htmx.min.js">
    </script>

    <script type="module">
    import { generateNavBar, generateBackground } from '/javascript/components/controller.js'
    const calsData   = <%- JSON.stringify(cals) %>;
    const sleepData  = <%- JSON.stringify(sleep) %>;
    generateBackground();
    generateNavBar();
    </script>

    <script src="/javascript/home.js"></script>



</body>
</html>
