<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, intial-scale=1" />
    <link rel="stylesheet" href="/css/home.css">
    <title>Home</title>
</head>
<body>
    <main class="main-content">
        <div class="home-page">

            <!-- Player name -->
            <h1 class="player-name">John</h1>

            <div class="home-layout">
                <div class="character-wrapper">
                    <img src="/Images/1st-place-avatar.png"
                        alt="Player sprite"
                        class="character-sprite">
                </div>

                <div class="stats-card">
                    <div class="stat-row">
                        <div class="stat-icon">
                            <img src="/Images/icon-fire.png"
                                alt="Calories">
                        </div>
                        <div class="stat-text">
                            <span class="stat-value"
                                id="stat-calories"><%= today.calories ?? '--' %></span>
                                <span class="stat-label">Kcal</span>
                        </div>
                    </div>

                    <div class="stat-row">
                        <div class="stat-icon">
                            <img src="/Images/icon-sleep.png"
                                alt="Sleep">
                        </div>
                        <div class="stat-text">
                            <span class="stat-value"
                                id="stat-sleep"><%= today.sleep_hours ?? '--' %></span>
                                <span class="stat-label">Sleep</span>
                        </div>
                    </div>

                    <div class="stat-row">
                        <div class="stat-icon">
                            <img src="/Images/icon-weight.png"
                                alt="Weight">
                        </div>
                        <div class="stat-text">
                            <span class="stat-value"
                                id="stat-weight"><%= today.weight ?? '--' %></span>
                                <span class="stat-label">Kg</span>
                        </div>
                    </div>

                    <div class="stat-row">
                        <div class="stat-icon">
                            <img src="/Images/icon-steps.png"
                                alt="Steps">
                        </div>
                        <div class="stat-text">
                            <span class="stat-value"
                                id="stat-steps"><%= today.step_count ?? '--' %></span>
                                <span class="stat-label">Steps</span>
                        </div>
                    </div>

                    <div class="stat-row">
                        <div class="stat-icon">
                            <img src="/Images/icon-water.png"
                                alt="Water">
                        </div>
                        <div class="stat-text">
                            <span class="stat-value"
                                id="stat-water"><%= today.water_intake ?? '--' %>(L)</span>
                                <span class="stat-label">Water</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Label and Progress bar -->
            <div class="level-section">
                <div class="level-labels">
                    <div class="level-main">
                        <span class="level-number"
                        id="level-number">100</span>
                        <span class="level-text">Level</span>
                    </div>
                    <div class="level-progress-text">
                        <span id="level-progress-text">25/100</span>
                    </div>
                </div>

                <div class="level bar">
                    <div class="level-bar-fill"
                        id="level-bar-fill"></div>
                </div>
            </div>
        </div>
    </main>

    <script src="/javascript/htmx.min.js">
    </script>

    <script type="module">
    import { generateNavBar, generateBackground } from '/javascript/components/controller.js'
    const calsData   = <%- JSON.stringify(cals) %>;
    const sleepData  = <%- JSON.stringify(sleep) %>;
    generateBackground();
    generateNavBar();
    </script>

    <script src="/javascript/home.js"></script>



</body>
</html>
